{
  "manifest_version": 3,
  "name": "Izuki — AI on your screen",
  "version": "1.1.0",
  "description": "Izuki in your browser: explain, translate, sum up, read aloud or save anything on a page; ask about the page; a focus guard; and Izuki's precise eyes and hands for web pages.",
  "permissions": [
    "scripting",
    "tabs",
    "alarms",
    "contextMenus",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Izuki",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "ask-page": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Ask Izuki about this page"
    }
  }
}