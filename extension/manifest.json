{
  "manifest_version": 3,
  "name": "Izuki — AI on your screen",
  "version": "1.5.4",
  "description": "Ask about pages with Izuki or an AI tab you connect. Explain, summarise and read selections, with chat beside the page.",
  "permissions": [
    "scripting",
    "tabs",
    "alarms",
    "contextMenus",
    "tts",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ask Izuki about this page"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "stop-workspace": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Stop the question or lab workspace"
    },
    "ask-page": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Open Izuki's side panel"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
