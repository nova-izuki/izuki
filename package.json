{
  "name": "izuki",
  "private": true,
  "version": "1.0.39",
  "type": "module",
  "description": "IZUKI — YO IZUKI, DO IT. Draw on your screen, Izuki does it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/make-icons.mjs",
    "test:phone": "node tools/phone-check/routing.test.cjs && node tools/phone-check/apps.test.cjs && node tools/phone-check/native.test.cjs && node tools/phone-check/audio.test.cjs",
    "test:conversation": "node tools/conversation-check.cjs",
    "test:voice": "node tools/voice-check.cjs",
    "test:companion": "node tools/companion-check.mjs",
    "test:html": "node tools/html-check.cjs docs/index.html && node tools/html-check.cjs docs/links/index.html && node tools/html-check.cjs docs/app/index.html && node tools/html-check.cjs src-tauri/src/call.html",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "overrides": {
    "sharp": "$sharp",
    "xcode": { "uuid": "11.1.1" }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@huggingface/transformers": "^3.8.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-opener": "2.5.5",
    "kokoro-js": "^1.2.1",
    "konva": "10.6.0",
    "lucide-react": "1.47.0",
    "motion": "13.4.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
